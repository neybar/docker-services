UID=1000
GID=100
PUID=1000
PGID=100
TZ=America/Denver
USERDIR=
DOCKERDIR=
LOCALDOCKERDIR=
# Optional. Parent of the services that need the local NVMe (Plex, NZBHydra2, Dolt): $NVME_DIR/<service>/<role>,
# listed in scripts/lib/nvme-paths.sh. Compose defaults it to /usr/local/docker (on /, the NVMe). Not LOCALDOCKERDIR,
# which is this repo checkout on the /home SATA SSD. Moving it means moving the data: see REBUILD.md §5.
#NVME_DIR=/usr/local/docker
SYNOLOGYDIR=
# Synology address: the NFS volumes in docker-compose.yml and the Synology/Homebridge routers in traefik-rules/.
NAS_IP=
SECRETSDIR=
EMAIL=

DOMAINNAME=
CLOUDFLARE_EMAIL=
CLOUDFLARE_DNS_API_TOKEN=
CLOUDFLARE_ZONEID=

HA_TOKEN=

PLEX_TOKEN=
TMDB_API_KEY=
TMDB_API_READ_ACCESS_TOKEN=

# CrowdSec bouncer key (Traefik <-> CrowdSec LAPI). Generate with: openssl rand -hex 32
CROWDSEC_BOUNCER_KEY=

# Beads SQL password (Dolt user `beads`). Generate with: openssl rand -hex 32
# Hex only. Compose passes it as a secret, not a container env var. See dolt/README.md.
DOLT_BEADS_PASSWORD=

# Gmail app password. Nothing in this repo reads it (host mail goes through postfix); kept so the key is documented.
GMAIL_APP_PASSWORD=

# Admin password for the LibreSpeed results page (PASSWORD in the librespeed service). Not a required variable.
LIBRESPEED_PASSWORD=

# Host port for Organizr. Only referenced by a commented-out port line in docker-compose.yml; leave blank.
ORGANIZR_PORT=
