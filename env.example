UID=1000
GID=100
PUID=1000
PGID=100
TZ=America/Denver
USERDIR=
DOCKERDIR=
LOCALDOCKERDIR=
SYNOLOGYDIR=
SECRETSDIR=
EMAIL=
# No HOST_IP or TAILSCALE_IP here: they are derived from the host at every compose run
# (scripts/lib/host-addrs.sh). Run compose by hand as ./scripts/compose.sh <args>.

DOMAINNAME=
CLOUDFLARE_EMAIL=
CLOUDFLARE_DNS_API_TOKEN=
CLOUDFLARE_ZONEID=

PIHOLE_PWD=

HA_TOKEN=

PLEX_TOKEN=
TMDB_API_KEY=
TMDB_API_READ_ACCESS_TOKEN=

# CrowdSec bouncer key (Traefik <-> CrowdSec LAPI). Generate with: openssl rand -hex 32
CROWDSEC_BOUNCER_KEY=

# Beads SQL password (Dolt user `beads`). Generate with: openssl rand -hex 32
# Hex only. Compose passes it as a secret, not a container env var. See CLAUDE.md (Dolt).
DOLT_BEADS_PASSWORD=
